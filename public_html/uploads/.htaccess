# Uploaded images only: scripts in this folder are never run or served
<FilesMatch "(?i)\.(php[0-9]?|phtml|phar|pht|pl|py|cgi|sh|asp|aspx|jsp|shtml)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php5 .php7 .php8 .phar
  RemoveType .php .phtml .php5 .php7 .php8 .phar
</IfModule>
Options -Indexes -ExecCGI
